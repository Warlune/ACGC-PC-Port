# IDE folders
.idea/
.vs/
.vscode/*

# Caches
__pycache__
.mypy_cache
.cache/

# Original files
orig/*/*
!orig/*/.gitkeep
*.dol
*.rel
*.elf
*.o
*.map
*.MAP

# Build files
build/
build32/
.ninja_*
build.ninja

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
/*.txt
!requirements.txt
*.exe

# Local game data, generated texture packs, models and player state
*.iso
*.gcm
*.ciso
*.wbfs
*.dds
*.gci
*.raw
*.dll
rom/
save/
texture_pack/
texture-packs/
texture-work/
toolchain/
native-runtime/
native-preview/
native-texture-test/
settings.ini
keybindings.ini
shader_cache.bin

# Persistent co-op host data and per-player credentials
/host/data/
town.sqlite3*
credentials.json
*.pyc

# For saving work files into (like IDB)
temp/

# Ignore the N64 SDK headers since we download them
# NOTE: include/PR/gbi.h and include/PR/ultratypes.h are force-tracked
# (git add -f) because they have TARGET_PC modifications for LE bitfields.
# configure.py skips download when they already exist.
include/PR/
include/gcc/
include/compiler/gcc/stdlib.h
